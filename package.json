{
  "name": "led-mapper",
  "version": "2.0.0",
  "private": true,
  "description": "Generate and visualize maps for irregular and/or gapped LED layouts, for FastLED, Pixelblaze and other libraries.",
  "author": "Jason Coon",
  "license": "GPL-3.0",
  "type": "module",
  "homepage": "https://jasoncoon.github.io/led-mapper",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jasoncoon/led-mapper.git"
  },
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "tsc --noEmit && eslint && vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@panzoom/panzoom": "^4.6.0",
    "antd": "^6.7.1",
    "lz-string": "^1.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bootstrap-icons": "^1.13.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
